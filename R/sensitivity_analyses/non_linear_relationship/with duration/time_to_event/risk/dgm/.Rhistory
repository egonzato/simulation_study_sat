risk0_365 = 1 - mean_surv0_365
risk1_365 = 1 - mean_surv1_365
# risk ratio
risk_ratio_365 = risk1_365 / risk0_365
set.seed(03111963)
n=1e6
df=data.frame(id=1:n,
onsetdate=as.Date(round(runif(n,17000,20000)),origin='1970-01-01'),
ageonset=runif(n,0.5,6),
event=1,
u=runif(n,0,1),
e=rnorm(n,0.5,0.02),
sex=sample(c('male','female'),n,replace=T))
# disease duration
df=df %>%
mutate(calendar=year(onsetdate),
linearpred=-0.004*ageonset+0.002*I(sex=='male')-0.001*calendar+e,
hazard=exp(linearpred),
timedays=rexp(n,hazard)*30,
stopdate=timedays+onsetdate)
# treatment model
df=df %>%
mutate(trialdate=as.Date('2015-05-23'),
trt_yoo=ifelse(stopdate>=trialdate,1,0),
ptrt_conf=1/(1+exp(-(+ 1.7*ageonset + 1.2*I(sex=='male')))),
trt_conf=rbinom(n,1,ptrt_conf),
trt=ifelse(trt_conf == 1 & trt_yoo == 1,1,0))
# number of treated
table(df$trt)
set.seed(03111963)
n=1e7
df=data.frame(id=1:n,
onsetdate=as.Date(round(runif(n,15000,20000)),origin='1970-01-01'),
ageonset=runif(n,0.5,6),
event=1,
u=runif(n,0,1),
e=rnorm(n,0.5,0.02),
sex=sample(c('male','female'),n,replace=T))
# disease duration
df=df %>%
mutate(calendar=year(onsetdate),
linearpred=-0.004*ageonset+0.002*I(sex=='male')-0.001*calendar+e,
hazard=exp(linearpred),
timedays=rexp(n,hazard)*30,
stopdate=timedays+onsetdate)
# treatment model
df=df %>%
mutate(trialdate=as.Date('2015-05-23'),
trt_yoo=ifelse(stopdate>=trialdate,1,0),
ptrt_conf=1/(1+exp(-(+ 1.7*ageonset + 1.2*I(sex=='male')))),
trt_conf=rbinom(n,1,ptrt_conf),
trt=ifelse(trt_conf == 1 & trt_yoo == 1,1,0))
# number of treated
table(df$trt)
target_population=df %>% mutate(trt==1)
# functions to fine tune
## compute risk ratio
compute_rr = function(k, t=365, pop=target_population){
s0 = mean(exp(-pop$hazard * t/30))
s1 = mean(exp(-k * pop$hazard * t/30))
risk0 = 1 - s0
risk1 = 1 - s1
risk1 / risk0
}
## find deflation factor
find_k = function(target, t=365, pop=target_population){
if (target == 1) return(1)
uniroot(function(k) compute_rr(k, t, pop) - target,
interval=c(1e-6, 1))$root
}
targets = c(1, 0.75, 0.5, 0.25)
ks = sapply(targets, find_k)
names(ks) = targets
df=df %>%
mutate(hazardtrt=hazard*ks["0.25"],
timedaystrt=ifelse(trt==1,
rexp(n(),hazardtrt),
NA_real_)*30,
duration=ifelse(trt==1,
trialdate-onsetdate,
round(timedays)),
timetotal=ifelse(trt==1,timedaystrt+duration,timedays),
start=as.Date(ifelse(trt==1,trialdate,onsetdate)),
stop=as.Date(ifelse(trt==1,start+timedaystrt,start+timedays)),
time=as.numeric(stop-start)) %>%
filter(duration>0)
# number of treated
table(df$trt)
writexl::write_xlsx(df,"C:\\Users\\P095206\\OneDrive - Amsterdam UMC\\Shared material with Elia\\PhD\\Project 5 - Simulation study in SATs\\Data\\population_dur.xlsx")
# divide treated and untreated
df=pop %>%
filter(trt==1) %>%
select(id,event,timedays,duration,timedaystrt,calendar)
counter=rbind(trt,trt) %>%
arrange(id) %>%
group_by(id) %>%
mutate(timec=ifelse(row_number()==1,timedaystrt,timedays-duration),
trtc=ifelse(row_number()==1,1,0),
eventc=ifelse(timec>=365,0,1),
timec=ifelse(timec>=365,365,timec)) %>%
ungroup() %>%
select(id,eventc,trtc,timec,calendar)
model=coxph(Surv(timec,eventc)~trtc+calendar,counter)
summary(model)
# treated and untreated dataset
newdata0=trt %>% mutate(trtc=0,calendar=calendar)
newdata1=trt %>% mutate(trtc=1,calendar=calendar)
# get baseline cumulative hazard once
bh=basehaz(model,centered=TRUE)
H0_365=approx(bh$time,bh$hazard,xout=365,method="constant",rule=2)$y
S0_365=exp(-H0_365)
# linear predictors
lp0=predict(model,newdata=newdata0,type="lp")
lp1=predict(model,newdata=newdata1,type="lp")
# individual survival probabilities at t=730
surv0_365 = S0_365 ^ exp(lp0)
surv1_365 = S0_365 ^ exp(lp1)
# mean probability
mean_surv0_365 = mean(surv0_365)
mean_surv1_365 = mean(surv1_365)
# get risk
risk0_365 = 1 - mean_surv0_365
risk1_365 = 1 - mean_surv1_365
# risk ratio
risk_ratio_365 = risk1_365 / risk0_365
df=df %>%
mutate(hazardtrt=hazard*ks["0.25"],
timedaystrt=ifelse(trt==1,
rexp(n(),hazardtrt),
NA_real_)*30,
duration=ifelse(trt==1,
trialdate-onsetdate,
round(timedays)),
timetotal=ifelse(trt==1,timedaystrt+duration,timedays),
start=as.Date(ifelse(trt==1,trialdate,onsetdate)),
stop=as.Date(ifelse(trt==1,start+timedaystrt,start+timedays)),
time=as.numeric(stop-start)) %>%
filter(duration>0)
