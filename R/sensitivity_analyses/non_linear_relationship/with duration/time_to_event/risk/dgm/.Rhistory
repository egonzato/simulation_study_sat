trt_yoo=ifelse(stopdate>=trialdate,1,0),
ptrt_conf=1/(1+exp(-(+ 1.7*ageonset + 1.2*I(sex=='male')))),
trt_conf=rbinom(n,1,ptrt_conf),
trt=ifelse(trt_conf == 1 & trt_yoo == 1,1,0))
# number of treated
table(df$trt)
