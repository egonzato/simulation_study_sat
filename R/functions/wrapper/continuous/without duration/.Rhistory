mutate(across(c(date,dateonset,starttrial,lastvisit,trialdate),as.Date)) %>%
mutate(time=time/365.25)
treateddf=trialdf %>%
filter(trt_overall==1)
matched=duration_matching_interpolation(data=trialdf,identifier=id,
y=hui_linear_trt,
treatment=trt_overall,
duration=duration,time=timen,
ratio=2)
2190/365.25
baseline <- trialdf %>%
group_by(id) %>%
mutate(idm = cur_group_id()) %>%
filter(row_number() == 1) %>%
ungroup()
treated <- baseline %>%
filter(trt_overall == 1)
untreated <- baseline %>%
filter(trt_overall == 0)
cat("Treated:", nrow(treated), "\n")
cat("Untreated:", nrow(untreated), "\n")
cat("Missing age of onset in treated:",
sum(is.na(treated$aoo)), "\n")
cat("Missing duration in treated:",
sum(is.na(treated$duration)), "\n")
cat("Missing sex in treated:",
sum(is.na(treated$sex)), "\n")
eligible_controls <- sapply(seq_len(nrow(treated)), function(i) {
sum(
untreated$sex == treated$sex[i] &
abs(untreated$aoo - treated$aoo[i]) <= 0.5 &
untreated$duration > treated$duration[i],
na.rm = TRUE
)
})
table(eligible_controls)
eligible_diagnostics <- data.frame(
treated_id = treated$id,
sex_matches = NA,
aoo_matches = NA,
duration_matches = NA,
all_matches = NA
)
for (i in seq_len(nrow(treated))) {
sex_match <- untreated$sex == treated$sex[i]
aoo_match <- abs(untreated$aoo - treated$aoo[i]) <= 0.5
duration_match <- untreated$duration > treated$duration[i]
eligible_diagnostics$sex_matches[i] <- sum(sex_match, na.rm = TRUE)
eligible_diagnostics$aoo_matches[i] <- sum(aoo_match, na.rm = TRUE)
eligible_diagnostics$duration_matches[i] <- sum(duration_match, na.rm = TRUE)
eligible_diagnostics$all_matches[i] <- sum(
sex_match & aoo_match & duration_match,
na.rm = TRUE
)
}
eligible_diagnostics
summary(treated$duration)
summary(untreated$duration)
