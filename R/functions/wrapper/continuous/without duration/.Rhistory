base="C:\\Users\\P095206\\OneDrive - Amsterdam UMC\\Shared material with Elia\\PhD\\Project 5 - Simulation study in SATs\\"
function_dirs=c(paste0(base,"Code\\paper\\R\\functions\\wrapper\\continuous\\with duration"),
paste0(base,"Code\\paper\\R\\functions\\matching"),
paste0(base,"Code\\paper\\R\\functions\\regression"))
for (i in 1:length(function_dirs)){
files=list.files(function_dirs[i], pattern = "\\.R$", full.names = TRUE)
sapply(files, source)
}
set.seed(3111963)
n=1e4
start_date=as.Date("2005-01-01")
end_date=as.Date("2022-12-31")
max_days=as.numeric(end_date - start_date)
backward_days=rtruncexp(n=n, rate=0.0002, max=max_days)
onsetdatev=end_date-floor(backward_days)
covs=data.frame(id=1:n,
dateonset=onsetdatev,
aoo=runif(n,0,8),
event=1,
u=runif(n,0,1),
e=rnorm(n,0.5,0.02),
sex=sample(c('male','female'),n,replace=T))
set.seed(181299)
t=seq(0,365.25*5,by=182.625)
tid=expand.grid(id=1:n,time=t)
df=merge(covs,tid,by='id') %>%
arrange(id,time) %>%
mutate(terr=ifelse(time==0,0,runif(n(),0,+90)),
date=dateonset+time+terr,
yoo=year(dateonset),
yoo_c=yoo-mean(yoo))
df=df %>%
group_by(id) %>%
mutate(row=row_number(),
u0=rnorm(1,0,0.07),
epsilon=rnorm(n(),0,0.08)) %>% ungroup()
df_sim=df %>%
group_by(id) %>%
mutate(trialdate=as.Date("2021-05-31"),
trt_elig=as.integer(any(date>=trialdate)),
ptrt_conf=1/(1+exp(-(0 - 0.339*aoo + 1.47*I(sex=='male')))),
trt_conf=rbinom(1,1,ptrt_conf),
trt_overall=as.integer(trt_conf==1 & trt_elig==1)) %>%
ungroup()
# drop historical controls who would have had access to treatment (same logic as before)
df_sim=df_sim %>% filter(!(trt_overall==0 & trt_elig==1))
# treated patients: keep only visits from the trial date onwards (earlier visits are pre-trial)
df_sim=df_sim %>% filter(trt_overall==0 | date>=trialdate) %>%
mutate(trt=trt_overall)
# reset the trial clock for treated patients: start at first post-trial visit, then 90-day spacing
# (vectorised replacement for the row-by-row loop)
df_sim=df_sim %>%
arrange(desc(trt_overall),id,date) %>%
group_by(id) %>%
mutate(starttrial=if(trt_overall[1]==1) min(date) else as.Date(NA),
date=if(trt_overall[1]==1) starttrial+90*(row_number()-1) else date,
firstvisit=min(date),
lastvisit=max(date)) %>%
ungroup()
set.seed(181299)
targets=c(0,0.025,0.075,0.15)
folder=paste0(base,"Data\\paper\\main_analysis\\with duration\\continuous\\population_diff_")
# time since first retained visit (trial time for treated) and disease duration (time since onset)
df_sim=df_sim %>%
mutate(timen=as.numeric(date-firstvisit)/365.25,
timen_trt=ifelse(trt==0,0,as.numeric(date-starttrial)/365.25),
duration=ifelse(trt_overall==1,
as.numeric(starttrial-dateonset)/365.25,
as.numeric(lastvisit-dateonset)/365.25),
b0=0.95 - (0.0097*mean(aoo) - 0.0449*mean(sex=="male") + 0.096*mean(yoo_c)),
# natural progression follows disease duration, not time in the registry/trial
hui_linear_untrt=(b0+u0) + 0.0097*aoo - 0.0449*(sex=="male") + 0.096*yoo_c - 0.1*timen + epsilon)
# loop and save
for (i in 1:length(targets)){
# treatment effect accrues with time on treatment (timen = 0 at trial entry)
out=df_sim %>% mutate(hui_linear_trt=hui_linear_untrt + 0*trt + targets[i]*trt*timen)
saveRDS(out, paste(folder,targets[i]*2,".rds",sep=""))
}
