bate=B$t0
lower=bate-1.96*sd(B$t)
upper=bate+1.96*sd(B$t)
# difference
ate;bate
ate=gcomp(trialdf,
estimate="ate",
estimand="ATC",
treatment="trt_overall",
time="timen",
formula=hui_linear_trt~(1|id)+trt_overall*timen+aoo+sex+yoo,
landmark=2)
set.seed(123)
B=boot(trialdf,
statistic=gcomp,
estimand="ATC",
estimate="ate",
treatment="trt_overall",
time="timen",
R=5,
formula=hui_linear_trt~(1|id)+trt_overall*timen+aoo+sex+yoo,
landmark=2)
# see results
bate=B$t0
lower=bate-1.96*sd(B$t)
upper=bate+1.96*sd(B$t)
# difference
ate;bate
7/8
29/37
library(pacman)
p_load(dplyr,readxl,stringr,ggplot2,forcats)
# load dataset
sats=read_xlsx('C:\\Users\\P095206\\OneDrive - Amsterdam UMC\\Shared material with Elia\\PhD\\Project 2 - review\\Documents\\Excel\\Extraction sheet.xlsx',sheet = 9)
sats=sats %>%
mutate(endpoint_str=word(Endpoint,1))
rcts=read_xlsx('C:\\Users\\P095206\\OneDrive - Amsterdam UMC\\Shared material with Elia\\PhD\\Project 2 - review\\Documents\\Excel\\Extraction sheet.xlsx',sheet = 8)
rcts=rcts %>%
mutate(endpoint_str=word(Endpoint,1),
design_str=word(DesignRCT,1))
sats %>%
mutate(hc=ifelse(`Historical data`=="Yes",
"Between patients",
"Within")) %>%
ggplot(.,aes(x=hc,fill=hc),col="black")+
labs(x="Comparisons",y="Count")+
guides(fill="none")+
scale_fill_manual(values=c('#FF0000','#0066FF',"#00CC33"))+
geom_bar(width=0.5,alpha=0.7)+
theme_bw()
p=sats %>%
mutate(hc = ifelse(`Historical data` == "Yes",
"Between patients (n=8)",
"Within (n=29)"),
endpoint_str = as.character(endpoint_str)) %>%
count(hc, endpoint_str, name = "n") %>%
complete(hc,
endpoint_str = c("Binary", "Continuous", "Time-to-event"),
fill = list(n = 0)) %>%
filter(n > 0) %>%
ggplot(aes(endpoint_str, n, fill = endpoint_str)) +
geom_col(col = "black", width = 0.5, alpha = 0.7) +
geom_text(aes(label = n), vjust = -0.4, size = 3) +
facet_wrap(~hc, scales = "free_x") +
labs(x="Endpoint",
#fill="",
y="Count")+
scale_x_discrete(drop = TRUE)+
guides(fill="none")+
scale_fill_manual(values=c('#FF0000','#0066FF',"#00CC33"))+
theme_bw()+
theme(strip.text = element_text(size = 8, face = "bold"),
strip.background = element_rect(fill = "white"),
legend.position = "bottom")
print(p)
ggsave(
"C:\\Users\\P095206\\OneDrive - Amsterdam UMC\\Shared material with Elia\\PhD\\Project 2 - review\\Figures\\poster\\endpoint_by_comparison.png",
p,
width = 4, height = 3, units = "in",
dpi = 300)
rcts %>%
mutate(design_str=ifelse(design_str=="Randomised-withdrawal",
"Withdrawal",design_str)) %>%
ggplot(.,aes(x=design_str))+
geom_bar(fill="white",col="black")+
labs(x="Design",
#fill="",
y="Count")+
theme_bw()
