"Between patients (n=8)",
"Within (n=29)"),
endpoint_str = as.character(endpoint_str)
) %>%
count(hc, endpoint_str, name = "n") %>%
complete(
hc,
endpoint_str = c("Binary", "Continuous", "Time-to-event"),
fill = list(n = 0)
) %>%
filter(n > 0) %>%
mutate(endpoint_str = reorder_within(endpoint_str, n, hc)) %>%
ggplot(aes(endpoint_str, n, fill = gsub("___.*", "", endpoint_str))) +
